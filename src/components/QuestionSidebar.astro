---
import ContentsHead from "./ContentsHead.astro";
import { sortProblemSets } from "../lib/reading-order";
interface ProblemSetEntry {
  slug: string;
  title: string;
}
interface QuestionEntry {
  id: string;
}
interface Props {
  subject: string;
  problemSets: ProblemSetEntry[];
  currentSlug: string;
  currentQuestions: QuestionEntry[];
}
const { subject, problemSets, currentSlug, currentQuestions } = Astro.props;

const sorted = sortProblemSets(problemSets);
const current = sorted.find((p) => p.slug === currentSlug);
const others = sorted.filter((p) => p.slug !== currentSlug);
---
<aside class="rail" id="contents-panel" aria-label="Contents">
  <ContentsHead label="Questions" />
  {current && <p class="toc-current">{current.title}</p>}
  {currentQuestions.length > 0 && (
    <ul class="toc-list">
      {currentQuestions.map((q) => (
        <li>
          <a href={`#${q.id}`} class="lvl-2">{q.id}</a>
        </li>
      ))}
    </ul>
  )}
  {others.length > 0 && (
    <nav class="toc-other">
      {others.map((p) => (
        <a href={`/subjects/${subject}/problem-sets/${p.slug}`}>{p.title}</a>
      ))}
    </nav>
  )}
</aside>
