---
import type { SectionId } from "../lib/nav";
interface Props {
  id: SectionId;
}
const { id } = Astro.props;
---
<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {id === "home" && <path d="M4 11l8-7 8 7M6 9.5V20h12V9.5M10 20v-5h4v5" />}
  {id === "courses" && <path d="M5 4v16M9 4v16M13.2 5.3l3-1 4 14.7-3 .9-4-14.6zM3 4h8M3 20h8" />}
  {id === "progress" && <path d="M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v1.5A3.5 3.5 0 0 0 7.5 11M17 6h3v1.5a3.5 3.5 0 0 1-3.5 3.5M12 14v4M8.5 20h7" />}
  {id === "you" && <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20a7.5 7.5 0 0 1 15 0" />}
</svg>
