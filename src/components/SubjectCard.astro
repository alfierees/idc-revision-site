---
interface Props {
  title: string;
  slug: string;
  placeholder: boolean;
  /** Optional small label above the title (omitted when a heading already names the semester). */
  eyebrow?: string;
  tagline?: string;
  /** "3 lectures · 8 past papers" — empty string hides the line. */
  counts?: string;
  href?: string;
  index: number;
}
const { title, slug, placeholder, eyebrow, tagline, counts, href, index } = Astro.props;
const delay = `${index * 60}ms`;
const STOP = new Set(["and", "of", "to", "for", "the", "in", "&", "-", "–"]);
const words = title.split(/\s+/).filter((w) => w && !STOP.has(w.toLowerCase()));
// "Accounting" → "AC", "Macro-Economics" → "MA", "Macro II" → "MII", "Maths for Economists A" → "MEA"
const initials = (
  words.length === 1
    ? words[0].slice(0, 2)
    : words.map((w) => (/^(I|II|III|IV)$/.test(w) ? w : w[0])).join("")
)
  .toUpperCase()
  .slice(0, 3);
const tone = index % 4;
---
{placeholder ? (
  <div class="subject-card placeholder" data-course={slug} style={`animation-delay: ${delay};`}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="await">Coming soon</p>
  </div>
) : (
  <a href={href} class="subject-card" data-course={slug} style={`animation-delay: ${delay};`}>
    <span class={`mono tone-${tone}${initials.length > 2 ? " mono-3" : ""}`} aria-hidden="true">{initials}</span>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 style={`view-transition-name: subj-${slug};`}>{title}</h2>
    {tagline && <p class="tagline">{tagline}</p>}
    <div class="foot">
      {counts && <p class="counts">{counts}</p>}
      <span class="open" aria-hidden="true"><span class="arr">→</span></span>
    </div>
  </a>
)}

<style>
  .subject-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    text-decoration: none;
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-soft);
    padding: 1.6rem 1.7rem 1.4rem;
    overflow: hidden;
    animation: rise-in 280ms ease-out both;
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.28s ease;
  }
  /* The stagger is a first-load welcome only; semester switches don't replay it. */
  :global(html.settled) .subject-card { animation: none; }
  .eyebrow {
    margin-bottom: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink-faint);
  }
  .mono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 1.1rem;
    border-radius: 12px;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .mono-3 { font-size: 0.78rem; letter-spacing: 0.02em; }
  .tone-0 { background: var(--color-accent-soft); color: var(--color-accent-ink); }
  .tone-1 { background: var(--color-accent-2-soft); color: var(--color-accent-2); }
  .tone-2 { background: var(--color-status-skipped-bg); color: var(--color-status-skipped); }
  .tone-3 { background: var(--color-status-done-bg); color: var(--color-status-done); }
  .subject-card h2 {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.18;
    font-variation-settings: "opsz" 48, "wght" 500;
    color: var(--color-ink);
    width: fit-content;
  }
  .tagline {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .foot {
    margin-top: auto;
    padding-top: 1.3rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .counts {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }
  .open {
    margin-left: auto;
    flex: none;
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .open .arr { display: inline-block; }
  .open .arr { transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.3, 1); }
  /* Hover lift only where there's a real pointer — taps on phones would stick. */
  @media (hover: hover) {
    a.subject-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
    a.subject-card:hover .open .arr { transform: translateX(5px); }
    a.subject-card:hover::after { transform: scaleX(1); }
  }
  .subject-card::after {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
    opacity: 0.85;
  }

  .subject-card.placeholder {
    min-height: 9rem;
    background: color-mix(in srgb, var(--color-paper-deep) 55%, var(--color-paper));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-rule) 70%, transparent);
    cursor: default;
  }
  .subject-card.placeholder h2 {
    font-size: 1.4rem;
    color: var(--color-ink-muted);
    font-variation-settings: "opsz" 48, "wght" 420;
  }
  .subject-card.placeholder .await {
    margin-top: auto;
    padding-top: 1rem;
    font-style: italic;
    color: var(--color-ink-faint);
    font-size: 0.95rem;
  }
  .subject-card.placeholder::after { display: none; }

  @media (max-width: 640px) {
    .subject-card { padding: 1.4rem 1.4rem 1.2rem; min-height: 0; }
    .subject-card h2 { font-size: 1.4rem; }
    .mono { width: 2.2rem; height: 2.2rem; margin-bottom: 0.8rem; font-size: 0.8rem; }
  }
</style>
