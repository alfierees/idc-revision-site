---
// Heading for a course's section index pages (Lectures, Past Papers, …).
interface Props {
  title: string;
  /** "13 lectures · In-class slide decks, reconstructed as notes." */
  sub?: string;
}
const { title, sub } = Astro.props;
---
<header class="page-head">
  <h1>{title}</h1>
  {sub && <p>{sub}</p>}
</header>

<style>
  .page-head { margin: 0.25rem 0 1.75rem; }
  h1 {
    font-family: var(--font-display);
    font-size: 2.3rem;
    line-height: 1.1;
    font-variation-settings: "opsz" 96, "wght" 500;
  }
  p {
    margin-top: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    color: var(--color-ink-muted);
  }
  @media (max-width: 640px) {
    .page-head { margin-bottom: 1.25rem; }
    h1 { font-size: 1.85rem; }
  }
</style>
