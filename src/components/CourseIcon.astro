---
import { courseIconSvg } from "../lib/course-icons";
interface Props {
  slug: string;
  title?: string;
  /** 0–3: which of the four soft tints to use. */
  tone?: number;
  size?: "md" | "sm";
}
const { slug, title = "", tone = 0, size = "md" } = Astro.props;
---
<span class={`course-icon tone-${tone % 4} ${size}`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={courseIconSvg(slug, title)} />
</span>

<style>
  .course-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
  }
  .course-icon svg { width: 1.5rem; height: 1.5rem; }
  .course-icon.sm { width: 2.25rem; height: 2.25rem; border-radius: 10px; }
  .course-icon.sm svg { width: 1.15rem; height: 1.15rem; }
  .tone-0 { background: var(--color-accent-soft); color: var(--color-accent-ink); }
  .tone-1 { background: var(--color-accent-2-soft); color: var(--color-accent-2); }
  .tone-2 { background: var(--color-status-skipped-bg); color: var(--color-status-skipped); }
  .tone-3 { background: var(--color-status-done-bg); color: var(--color-status-done); }
</style>
