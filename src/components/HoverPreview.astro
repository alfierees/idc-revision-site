---
interface Props { subject: string; }
const { subject } = Astro.props;

// The preview data lives in one file per subject (concept-previews.json.ts),
// so pages carry only its URL, not ~50 KB of inlined JSON each.
const prefix = `/subjects/${subject}/dictionary/`;
const previewsUrl = `/subjects/${subject}/concept-previews.json`;
---
<div id="concept-preview-card" role="tooltip" hidden data-prefix={prefix} data-src={previewsUrl}></div>

<style is:global>
  #concept-preview-card {
    position: absolute;
    z-index: 50;
    max-width: 24rem;
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.75rem 0.9rem;
    background: var(--color-card);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 12%);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  #concept-preview-card .cp-title { font-weight: 600; color: var(--color-ink); display: block; margin-bottom: 0.3rem; }
  #concept-preview-card .cp-lecture { display: block; margin-top: 0.45rem; font-size: 0.75rem; color: var(--color-ink-muted); }
  #concept-preview-card .katex { font-size: 1em; }
</style>

<script>
  import type { ConceptPreview } from "../lib/concept-previews";

  const card = document.getElementById("concept-preview-card");
  if (card) {
    const prefix = card.dataset.prefix || "";
    const previewsUrl = card.dataset.src || "";
    let data: Record<string, ConceptPreview> | null = null;
    let dataLoading: Promise<void> | null = null;
    // The link a preview is wanted for; a fetch that lands after the pointer
    // has left must not pop a card up.
    let wantedAnchor: HTMLAnchorElement | null = null;
    let hideTimer: number | undefined;

    // Fetch once per page (the browser cache serves other pages of the same
    // subject). A failed fetch just means no preview, never an error; the
    // next hover tries again.
    const loadData = (): Promise<void> =>
      (dataLoading ??= fetch(previewsUrl)
        .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
        .then((loaded) => { data = loaded && typeof loaded === "object" ? loaded : {}; })
        .catch(() => { dataLoading = null; }));

    const esc = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    const slugFromHref = (href: string): string | null => {
      try {
        const url = new URL(href, location.origin);
        if (!url.pathname.startsWith(prefix)) return null;
        return url.pathname.slice(prefix.length).split("#")[0].replace(/\/$/, "");
      } catch { return null; }
    };

    const render = (a: HTMLAnchorElement, slug: string) => {
      const d = data?.[slug];
      if (!d) return;
      // d.defHtml is trusted build-time-rendered KaTeX/markdown HTML from the
      // user's own vault; title and lecture are plain text and are escaped.
      card.innerHTML =
        `<span class="cp-title">${esc(d.title)}</span>${d.defHtml}` +
        (d.lecture ? `<span class="cp-lecture">→ ${esc(d.lecture)}</span>` : "");
      const r = a.getBoundingClientRect();
      card.style.top = `${window.scrollY + r.bottom + 6}px`;
      card.style.left = `${window.scrollX + Math.min(r.left, window.innerWidth - 384)}px`;
      card.hidden = false;
    };

    const show = (a: HTMLAnchorElement) => {
      const slug = slugFromHref(a.getAttribute("href") || "");
      if (!slug) return;
      wantedAnchor = a;
      // Once loaded, show synchronously as before: iOS Safari only turns a
      // tap into a preview when the card appears inside the mouseover handler.
      if (data) { render(a, slug); return; }
      loadData().then(() => { if (wantedAnchor === a) render(a, slug); });
    };
    const hideNow = () => { wantedAnchor = null; card.hidden = true; };
    const hide = () => { hideTimer = window.setTimeout(hideNow, 120); };
    const cancelHide = () => { if (hideTimer) window.clearTimeout(hideTimer); };

    document.body.addEventListener("mouseover", (e) => {
      const a = (e.target as HTMLElement).closest("a") as HTMLAnchorElement | null;
      if (a && slugFromHref(a.getAttribute("href") || "")) { cancelHide(); show(a); }
    });
    document.body.addEventListener("mouseout", (e) => {
      const a = (e.target as HTMLElement).closest("a");
      if (a) hide();
    });
    card.addEventListener("mouseenter", cancelHide);
    card.addEventListener("mouseleave", hide);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") hideNow(); });
    document.body.addEventListener("focusin", (e) => {
      const a = (e.target as HTMLElement).closest("a") as HTMLAnchorElement | null;
      if (a && slugFromHref(a.getAttribute("href") || "")) { cancelHide(); show(a); }
    });

    // Warm the data once the page is idle, only on pages that link to the
    // dictionary, so the first hover or tap usually finds it ready.
    const linksToDictionary = Array.from(document.querySelectorAll("a[href]"))
      .some((a) => slugFromHref(a.getAttribute("href") || ""));
    if (linksToDictionary) {
      const whenIdle: (callback: () => void) => unknown =
        window.requestIdleCallback ?? ((callback) => window.setTimeout(callback, 1500));
      whenIdle(() => { loadData(); });
    }
  }
</script>
