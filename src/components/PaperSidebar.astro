---
import { comparePapers, type PaperLabel } from "../lib/paper-label";
interface PaperEntry extends PaperLabel { slug: string; }
interface Section { id: string; text: string; html?: string; level: number; }
interface Props {
  subject: string;
  papers: PaperEntry[];
  currentSlug: string;
  currentSections: Section[];
}
const { subject, papers, currentSlug, currentSections } = Astro.props;
const sorted = [...papers].sort(comparePapers);
const current = sorted.find((p) => p.slug === currentSlug);
const others = sorted.filter((p) => p.slug !== currentSlug);
---
<aside class="rail">
  <p class="toc-label">Past Papers</p>
  {current && <p class="toc-current">{current.label}</p>}
  {currentSections.length > 0 && (
    <ul class="toc-list">
      {currentSections.map((s) => (
        <li>
          {s.html ? (
            <a href={`#${s.id}`} class={s.level === 3 ? "lvl-3" : "lvl-2"} set:html={s.html} />
          ) : (
            <a href={`#${s.id}`} class={s.level === 3 ? "lvl-3" : s.level === 1 ? "lvl-1" : "lvl-2"}>{s.text}</a>
          )}
        </li>
      ))}
    </ul>
  )}
  {others.length > 0 && (
    <nav class="toc-other">
      {others.map((p) => (
        <a href={`/subjects/${subject}/past-papers/${p.slug}`}>{p.label}</a>
      ))}
    </nav>
  )}
</aside>
