---
import "../styles/globals.css";
import { getCollection } from "astro:content";
import Analytics from '@vercel/analytics/astro';
import { groupBySemester } from "../lib/semesters";
import BadgeToaster from "./progress/BadgeToaster";
import CourseChip from "./progress/CourseChip";
import NavIcon from "./NavIcon.astro";
import { PROGRESS_UI_ENABLED } from "../lib/progress/flags";
import { activeSection, visibleSections } from "../lib/nav";

interface Props {
  title?: string;
  /** Subject slug — when set, the header shows the subject switcher + section tabs. */
  subject?: string;
  active?: "lectures" | "dictionary" | "recipes" | "problem-sets" | "past-papers" | "exam-prep";
  /** Show the sidebar collapse toggle (pages with a #content-grid rail). */
  hasSidebar?: boolean;
  /** Item pages (lecture, problem set, past paper): the title recorded for "Continue where you left off". */
  continueTitle?: string;
}
const { title = "IDC Revision", subject, active, hasSidebar = false, continueTitle } = Astro.props;
const navSections = visibleSections(PROGRESS_UI_ENABLED);
const currentSection = activeSection(Astro.url.pathname);

const subjects = (await getCollection("subjects")).map((s) => s.data);
const current = subject ? subjects.find((s) => s.slug === subject) : undefined;
// Header switcher: live courses only, under their semester, current semester first.
const switcherGroups = groupBySemester(subjects)
  .filter((g) => g.live.length > 0)
  .sort((a, b) => {
    const isCurrent = (g: typeof a) => g.live.some((s) => s.slug === subject);
    return Number(isCurrent(b)) - Number(isCurrent(a));
  });

const tabs = [
  { id: "lectures",     label: "Lectures" },
  { id: "dictionary",   label: "Dictionary" },
  { id: "exam-prep",    label: "Exam Prep" },
  { id: "problem-sets", label: "Problem Sets" },
  { id: "past-papers",  label: "Past Papers" },
] as const;
const section = active ?? "dictionary";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <Analytics />
    <script is:inline>
      // Cross-page view transitions (see globals.css) are skipped when the tab
      // is hidden or the user navigates mid-transition. That's fine, but Chrome
      // reports the skip as an uncaught promise error unless it's handled.
      ["pageswap", "pagereveal"].forEach(function (type) {
        addEventListener(type, function (event) {
          var transition = event.viewTransition;
          if (!transition) return;
          transition.ready.catch(function () {});
          transition.finished.catch(function () {});
          transition.updateCallbackDone.catch(function () {});
        });
      });
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <div class="read-progress" id="read-progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="bar">
        <a href="/" class="brand"><img class="brand-mark" src="/images/brand/idc-mark.webp" alt="" width="29" height="24" /> <span class="brand-name">IDC Revision</span></a>
        <nav class="main-nav top-nav" aria-label="Main">
          {navSections.map((n) => (
            <a href={n.href} class={currentSection === n.id ? "active" : ""} aria-current={currentSection === n.id ? "page" : undefined}>
              <NavIcon id={n.id} /><span>{n.label}</span>
            </a>
          ))}
        </nav>
        <div class="bar-right">
          {hasSidebar && (
            <button id="sidebar-toggle" type="button" class="panel-toggle" aria-pressed="false" title="Toggle sidebar">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
            </button>
          )}
        </div>
      </div>
      {current && (
        <div class="course-row">
          <div class="course-row-inner">
            <div class="course-head">
              <div class="subject-menu" id="subject-menu">
                <button
                  type="button"
                  class="subject-trigger"
                  aria-expanded="false"
                  aria-haspopup="menu"
                >
                  <span class="subject-name" style={`view-transition-name: subj-${current.slug};`}>{current.title}</span>
                  <span class="chev" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                  </span>
                </button>
                <div class="subject-pop" hidden role="menu">
                  <p class="subject-pop-label">Switch course</p>
                  {switcherGroups.map((g) => (
                    <div class="subject-group" role="group" aria-label={g.semester.label}>
                      <p class="subject-group-label">{g.semester.label}</p>
                      {g.live.map((s) => (
                        <a
                          href={`/subjects/${s.slug}/${section}`}
                          class={`subject-opt ${s.slug === subject ? "current" : ""}`}
                          role="menuitem"
                        >
                          {s.title}
                          {s.slug === subject && <span class="so-tick" aria-hidden="true">●</span>}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
              {PROGRESS_UI_ENABLED && subject && <CourseChip client:idle subject={subject} />}
            </div>
            <nav class="header-tabs" aria-label="Subject sections">
              {tabs.map((t) => (
                <a
                  href={`/subjects/${subject}/${t.id}`}
                  class={active === t.id ? "active" : ""}
                  aria-current={active === t.id ? "page" : undefined}
                >
                  {t.label}
                </a>
              ))}
            </nav>
          </div>
        </div>
      )}
    </header>
    <main class="site-main mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>

    <nav class="main-nav bottom-nav" aria-label="Main">
      {navSections.map((n) => (
        <a href={n.href} class={currentSection === n.id ? "active" : ""} aria-current={currentSection === n.id ? "page" : undefined}>
          <NavIcon id={n.id} /><span>{n.label}</span>
        </a>
      ))}
    </nav>
    {continueTitle && subject && <div id="last-seen-data" hidden data-subject={subject} data-title={continueTitle}></div>}

    <script>
      import { progressStore } from "../lib/progress/store";

      // ---- last seen (for "Continue where you left off" on Home) ----
      const lastSeenData = document.getElementById("last-seen-data");
      if (lastSeenData?.dataset.subject && lastSeenData.dataset.title) {
        try {
          progressStore().recordLastSeen(lastSeenData.dataset.subject, location.pathname, lastSeenData.dataset.title);
        } catch {}
      }

      // ---- reading progress bar ----
      const prog = document.getElementById("read-progress");
      if (prog) {
        const onScroll = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          prog.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + "%";
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // ---- subject dropdown ----
      const menu = document.getElementById("subject-menu");
      const trigger = menu?.querySelector<HTMLButtonElement>(".subject-trigger");
      const pop = menu?.querySelector<HTMLElement>(".subject-pop");
      if (menu && trigger && pop) {
        const setOpen = (open: boolean) => {
          pop.hidden = !open;
          trigger.setAttribute("aria-expanded", String(open));
        };
        trigger.addEventListener("click", () => setOpen(pop.hidden));
        document.addEventListener("mousedown", (e) => {
          if (!menu.contains(e.target as Node)) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
      }

      // ---- sidebar collapse (toggle lives in the header) ----
      const KEY = "idc-sidebar-hidden";
      const grid = document.getElementById("content-grid");
      const toggleBtn = document.getElementById("sidebar-toggle");
      if (grid && toggleBtn) {
        const apply = (hidden: boolean) => {
          grid.classList.toggle("sidebar-collapsed", hidden);
          toggleBtn.classList.toggle("active", !hidden);
          toggleBtn.setAttribute("aria-pressed", String(!hidden));
          toggleBtn.setAttribute("title", hidden ? "Show sidebar" : "Hide sidebar");
        };
        apply(localStorage.getItem(KEY) === "1");
        toggleBtn.addEventListener("click", () => {
          const hidden = !grid.classList.contains("sidebar-collapsed");
          localStorage.setItem(KEY, hidden ? "1" : "0");
          apply(hidden);
        });
      }

      // ---- TOC scroll-spy ----
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.toc-list a[href^="#"]'),
      );
      if (tocLinks.length > 0) {
        const targets = tocLinks
          .map((a) => {
            const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
            return el ? { a, el } : null;
          })
          .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => x !== null);
        const header = document.querySelector<HTMLElement>(".site-header");
        const onSpy = () => {
          const off = (header?.offsetHeight ?? 85) + 40;
          const y = window.scrollY + off;
          let cur: HTMLAnchorElement | null = null;
          for (const t of targets) {
            if (t.el.offsetTop <= y) cur = t.a;
          }
          for (const t of targets) t.a.classList.toggle("active", t.a === cur);
        };
        onSpy();
        window.addEventListener("scroll", onSpy, { passive: true });
      }
    </script>
    <BadgeToaster client:idle />
  </body>
</html>
