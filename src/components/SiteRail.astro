---
// One nav element for every width: the left rail from 1024px, the course bar
// (switcher plus section slots) below that.
import { getCollection } from "astro:content";
import CourseChip from "./progress/CourseChip";
import NavIcon from "./NavIcon.astro";
import { loadCourseContent } from "../lib/course-content";
import {
  availableSections,
  courseSectionHref,
  switchCourseHref,
  type CourseContentCounts,
  type CourseSectionId,
} from "../lib/course-sections";
import { activeSection, visibleSections } from "../lib/nav";
import { PROGRESS_UI_ENABLED } from "../lib/progress/flags";
import { groupBySemester } from "../lib/semesters";

interface Props {
  subject?: string;
  activeCourseSection?: CourseSectionId;
  hasSidebar?: boolean;
}
const { subject, activeCourseSection = "overview", hasSidebar = false } = Astro.props;

const NO_CONTENT: CourseContentCounts = { pastPapers: 0, problemSets: 0, lectures: 0, dictionary: 0, examPrep: 0, recipes: 0 };
const courseContent = await loadCourseContent();
const countsFor = (slug: string) => courseContent.get(slug)?.counts ?? NO_CONTENT;

const subjects = (await getCollection("subjects")).map((entry) => entry.data);
const currentCourse = subject ? subjects.find((entry) => entry.slug === subject) : undefined;
const liveGroups = groupBySemester(subjects).filter((group) => group.live.length > 0);
// Switcher: the current course's semester first.
const switcherGroups = [...liveGroups].sort((first, second) => {
  const holdsCurrent = (group: typeof first) => group.live.some((entry) => entry.slug === subject);
  return Number(holdsCurrent(second)) - Number(holdsCurrent(first));
});
const sections = currentCourse ? availableSections(countsFor(currentCourse.slug)) : [];
const navSections = visibleSections(PROGRESS_UI_ENABLED);
const currentNavSection = activeSection(Astro.url.pathname);
---
<aside class:list={["site-rail", { "in-course": currentCourse }]} aria-label="Site navigation">
  <div class="site-rail-top">
    <a href="/" class="brand"><img class="brand-mark" src="/images/brand/idc-mark.webp" alt="" width="29" height="24" /> <span class="brand-name">IDC Revision</span></a>
    {hasSidebar && (
      <button id="sidebar-toggle" type="button" class="panel-toggle" aria-pressed="false" title="Toggle contents">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
      </button>
    )}
  </div>

  {currentCourse && (
    <div class="subject-menu" id="subject-menu">
      <button type="button" class="subject-trigger" aria-expanded="false" aria-haspopup="menu">
        <span class="subject-name" style={`view-transition-name: subj-${currentCourse.slug};`}>{currentCourse.title}</span>
        <span class="chev" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </span>
      </button>
      <div class="subject-pop" hidden role="menu">
        <p class="subject-pop-label">Switch course</p>
        {switcherGroups.map((group) => (
          <div class="subject-group" role="group" aria-label={group.semester.label}>
            <p class="subject-group-label">{group.semester.label}</p>
            {group.live.map((entry) => (
              <a
                href={switchCourseHref(entry.slug, countsFor(entry.slug), activeCourseSection)}
                class={`subject-opt ${entry.slug === subject ? "current" : ""}`}
                role="menuitem"
              >
                {entry.title}
                {entry.slug === subject && <span class="so-tick" aria-hidden="true">●</span>}
              </a>
            ))}
          </div>
        ))}
      </div>
      {PROGRESS_UI_ENABLED && subject && <CourseChip client:idle subject={subject} />}
    </div>
  )}

  {currentCourse ? (
    <nav class="rail-sections" aria-label="Course sections">
      {sections.map((section) => (
        <a
          href={courseSectionHref(currentCourse.slug, section.id)}
          class:list={["rail-link", { active: activeCourseSection === section.id, nested: section.nested, "rail-only": !section.shortLabel }]}
          aria-current={activeCourseSection === section.id ? "page" : undefined}
        >
          {section.shortLabel && <span class="label-short">{section.shortLabel}</span>}
          <span class="label-long">{section.label}</span>
          <span class="rail-count" data-section-count={section.id} hidden></span>
        </a>
      ))}
    </nav>
  ) : (
    <nav class="rail-courses" aria-label="Your semester's courses">
      {liveGroups.map((group) => (
        <div class="rail-semester" data-sem={group.semester.id}>
          <p class="rail-heading">{group.semester.label}</p>
          {group.live.map((entry) => (
            <a class="rail-link" href={courseSectionHref(entry.slug, "overview")}><span class="label-long">{entry.title}</span></a>
          ))}
        </div>
      ))}
    </nav>
  )}

  <nav class="main-nav rail-global" aria-label="Main">
    {navSections.map((navSection) => (
      <a href={navSection.href} class={currentNavSection === navSection.id ? "active" : ""} aria-current={currentNavSection === navSection.id ? "page" : undefined}>
        <NavIcon id={navSection.id} /><span>{navSection.label}</span>
      </a>
    ))}
  </nav>
</aside>
