---
import Layout from "../components/Layout.astro";
import SubjectCard from "../components/SubjectCard.astro";
import ProgressOverview from "../components/progress/ProgressOverview";
import { getCollection } from "astro:content";
import { groupBySemester, countsLine, SEMESTERS, SEMESTER_STORAGE_KEY } from "../lib/semesters";

const subjects = (await getCollection("subjects")).map((s) => s.data);
const lectures = await getCollection("lectures");
const problemSets = await getCollection("problem-sets");
const pastPapers = await getCollection("past-papers");

const countFor = (entries: { data: { subject: string } }[], slug: string) =>
  entries.filter((e) => e.data.subject === slug).length;

const groups = groupBySemester(subjects);
const semesterIds = SEMESTERS.map((s) => s.id);

const cardFor = (subject: (typeof subjects)[number], index: number) => {
  const lectureCount = countFor(lectures, subject.slug);
  return {
    title: subject.title,
    slug: subject.slug,
    placeholder: subject.placeholder,
    tagline: subject.tagline,
    counts: countsLine({
      lectures: lectureCount,
      problemSets: countFor(problemSets, subject.slug),
      pastPapers: countFor(pastPapers, subject.slug),
    }),
    // Lectures are the friendliest first page; fall back if a course has none yet.
    href: `/subjects/${subject.slug}/${lectureCount > 0 ? "lectures" : "dictionary"}`,
    index,
  };
};

const courses = (n: number) => `${n} course${n === 1 ? "" : "s"}`;
const tileNote = (live: number, coming: number) =>
  live > 0 ? courses(live) : coming > 0 ? `${courses(coming)} coming soon` : "Coming soon";
---
<Layout title="IDC Revision">
  <script slot="head" is:inline define:vars={{ semesterIds, storageKey: SEMESTER_STORAGE_KEY }}>
    // Runs before first paint: pick the semester from the link (#y1s1) or the
    // last choice on this device, so the right courses show without a flash.
    (function () {
      var root = document.documentElement;
      root.classList.add("js");
      var fromHash = location.hash.slice(1);
      var chosen = null;
      try { chosen = localStorage.getItem(storageKey); } catch (e) {}
      if (semesterIds.indexOf(fromHash) >= 0) {
        chosen = fromHash;
        try { localStorage.setItem(storageKey, chosen); } catch (e) {}
      }
      if (semesterIds.indexOf(chosen) >= 0) root.setAttribute("data-semester", chosen);
    })();
  </script>

  <section class="reading home-hero">
    <p class="font-ui text-xs uppercase tracking-[0.18em] text-ink-muted">Entrepreneurship, Economics &amp; Data Science</p>
    <h1 class="mt-3 font-display text-[2.15rem] leading-[1.12] sm:text-4xl" style="font-variation-settings: 'opsz' 96, 'wght' 500;">
      Everything we learnt, in one place.
    </h1>
    <p class="mt-4 text-base text-ink-soft">
      Notes, past papers and worked problem sets for every course, Years 1 and 2.
    </p>
  </section>

  <section class="sem-picker" aria-labelledby="sem-picker-title">
    <h2 id="sem-picker-title" class="picker-title">Which semester are you in?</h2>
    <div class="tiles">
      {groups.map((g) => (
        <a href={`#${g.semester.id}`} class={`tile ${g.live.length === 0 ? "quiet" : ""}`} data-pick={g.semester.id}>
          <span class="tile-year">Year {g.semester.year}</span>
          <span class="tile-sem">Semester {g.semester.semester}</span>
          <span class="tile-note">
            {tileNote(g.live.length, g.coming.length)}
            {g.live.length > 0 && <span class="tile-arr" aria-hidden="true">→</span>}
          </span>
          <span class="tile-cov" data-semester-progress={g.semester.id} hidden></span>
        </a>
      ))}
    </div>
  </section>

  <nav class="sem-switch" aria-label="Semester">
    {groups.map((g) => (
      <a href={`#${g.semester.id}`} class="pill" data-pick={g.semester.id} aria-label={g.semester.label}>
        <span class="pill-long" aria-hidden="true">Year {g.semester.year} · Sem {g.semester.semester}</span>
        <span class="pill-short" aria-hidden="true">{g.semester.short}</span>
      </a>
    ))}
  </nav>

  {groups.map((g) => (
    <section class="sem-panel" data-sem={g.semester.id} aria-labelledby={`sem-title-${g.semester.id}`}>
      <h2 class="panel-title" id={`sem-title-${g.semester.id}`}>{g.semester.label}</h2>
      {g.live.length + g.coming.length === 0 ? (
        <p class="panel-empty">Courses for this semester are on their way.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[...g.live, ...g.coming].map((s, i) => (
            <SubjectCard {...cardFor(s, i)} />
          ))}
        </div>
      )}
    </section>
  ))}

  <section id="progress" class="progress-home">
    <ProgressOverview client:idle />
  </section>
</Layout>

<style>
  .home-hero { margin-bottom: 2.75rem; }

  /* ---- which view shows: picker (first visit) vs switcher + one panel ----
     Without JS (no .js on <html>) everything stays visible, stacked. */
  :global(html.js:not([data-semester])) .sem-switch,
  :global(html.js:not([data-semester])) .sem-panel { display: none; }
  :global(html.js[data-semester]) .sem-picker { display: none; }
  :global(html.js[data-semester]) .sem-panel { display: none; }
  :global(html[data-semester="y1s1"]) .sem-panel[data-sem="y1s1"],
  :global(html[data-semester="y1s2"]) .sem-panel[data-sem="y1s2"],
  :global(html[data-semester="y2s1"]) .sem-panel[data-sem="y2s1"],
  :global(html[data-semester="y2s2"]) .sem-panel[data-sem="y2s2"] { display: block; }
  :global(html[data-semester="y1s1"]) .pill[data-pick="y1s1"],
  :global(html[data-semester="y1s2"]) .pill[data-pick="y1s2"],
  :global(html[data-semester="y2s1"]) .pill[data-pick="y2s1"],
  :global(html[data-semester="y2s2"]) .pill[data-pick="y2s2"] {
    background: var(--color-accent);
    color: var(--color-card);
    box-shadow: none;
  }

  /* ---- first-visit picker ---- */
  .picker-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-variation-settings: "opsz" 36, "wght" 480;
    color: var(--color-ink);
  }
  .tiles {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    max-width: 46rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.75rem 1.4rem;
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.28s ease;
  }
  .tile-arr { font-size: 1rem; transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.3, 1); }
  @media (hover: hover) {
    .tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
    .tile:hover .tile-arr { transform: translateX(5px); }
    .tile.quiet:hover { transform: translateY(-2px); }
  }
  .tile-year {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1.1;
    font-variation-settings: "opsz" 72, "wght" 500;
    color: var(--color-ink);
  }
  .tile-sem {
    margin-top: 0.15rem;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }
  .tile-note {
    margin-top: 1.1rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent);
  }
  .tile-cov {
    margin-top: 0.3rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .tile-cov[hidden] { display: none; }
  .tile.quiet {
    background: color-mix(in srgb, var(--color-paper-deep) 55%, var(--color-paper));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-rule) 70%, transparent);
  }
  .tile.quiet .tile-year { color: var(--color-ink-muted); }
  .tile.quiet .tile-note { font-family: var(--font-body); font-style: italic; font-weight: 400; font-size: 0.95rem; color: var(--color-ink-faint); }

  /* ---- switcher row ---- */
  .sem-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .pill {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    color: var(--color-ink-soft);
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .pill:hover { color: var(--color-ink); background: var(--color-paper-deep); }
  .pill-short { display: none; }

  /* ---- panels ---- */
  .sem-panel + .sem-panel { margin-top: 3rem; }
  :global(html.js) .sem-panel + .sem-panel { margin-top: 0; }
  .panel-title {
    margin-bottom: 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-muted);
  }
  .panel-empty { font-style: italic; color: var(--color-ink-faint); }

  @media (max-width: 640px) {
    .pill-long { display: none; }
    .pill-short { display: inline; }
    .sem-switch { gap: 0.4rem; }
    .pill { padding: 0.5rem 0.85rem; }
    .home-hero { margin-bottom: 2rem; }
    .picker-title { font-size: 1.3rem; }
    .tiles { gap: 0.75rem; }
    .tile { padding: 1.1rem 1.1rem 1rem; }
    .tile-year { font-size: 1.6rem; }
    .tile-sem { font-size: 0.98rem; }
    .tile-note { margin-top: 0.8rem; }
  }
</style>

<script>
  import { isSemesterId, SEMESTER_STORAGE_KEY } from "../lib/semesters";

  import { evaluate, loadTotals } from "../lib/progress/client";

  const root = document.documentElement;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const show = (id: string) => {
    root.setAttribute("data-semester", id);
    document.querySelectorAll<HTMLAnchorElement>(".pill[data-pick]").forEach((pill) => {
      if (pill.dataset.pick === id) pill.setAttribute("aria-current", "true");
      else pill.removeAttribute("aria-current");
    });
  };

  const current = root.getAttribute("data-semester");
  if (current) show(current);

  window.addEventListener("hashchange", () => {
    const id = location.hash.slice(1);
    if (!isSemesterId(id)) return;
    try { localStorage.setItem(SEMESTER_STORAGE_KEY, id); } catch {}
    root.classList.add("settled");
    if ("startViewTransition" in document && !reducedMotion.matches) {
      document.startViewTransition(() => show(id));
    } else {
      show(id);
    }
  });

  // Coverage on cards and tiles: filled in after load from this device's marks.
  const fillCoverage = async () => {
    try {
      const { degree } = evaluate(await loadTotals());
      for (const course of degree.courses) {
        const bar = document.querySelector<HTMLElement>(`[data-course-progress="${course.slug}"]`);
        if (!bar || course.percent <= 0) continue;
        bar.style.setProperty("--pct", `${course.percent}%`);
        const label = bar.querySelector(".cov-label");
        if (label) label.textContent = `${course.percent}%`;
        bar.hidden = false;
      }
      const bySemester = new Map<string, number[]>();
      for (const course of degree.courses) {
        const id = `y${course.year}s${course.semester}`;
        bySemester.set(id, [...(bySemester.get(id) ?? []), course.percent]);
      }
      for (const [id, percents] of bySemester) {
        const line = document.querySelector<HTMLElement>(`[data-semester-progress="${id}"]`);
        const mean = Math.round(percents.reduce((sum, p) => sum + p, 0) / percents.length);
        if (!line || mean <= 0) continue;
        line.textContent = `${mean}% covered`;
        line.hidden = false;
      }
    } catch {}
  };
  fillCoverage();
</script>
