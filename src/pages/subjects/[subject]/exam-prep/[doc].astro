---
import Layout from "../../../../components/Layout.astro";
import HoverPreview from "../../../../components/HoverPreview.astro";
import ExamPrepSidebar from "../../../../components/ExamPrepSidebar.astro";
import GraphMounter from "../../../../components/GraphMounter.astro";
import Mermaid from "../../../../components/Mermaid.astro";
import PageHead from "../../../../components/PageHead.astro";
import PageFoot from "../../../../components/PageFoot.astro";
import { getCollection, getEntry } from "astro:content";
import { renderMarkdownString } from "../../../../lib/render-markdown-string";
import { buildLinkMap } from "../../../../lib/known-links";
import { conceptLinks } from "../../../../lib/concepts";
import { loadCourseContent } from "../../../../lib/course-content";
import { neighbours, sortExamPrep } from "../../../../lib/reading-order";
import { stripVaultLeadIn, vaultKeyConcepts } from "../../../../lib/vault-lead-in";
import { decodeHtmlEntities } from "../../../../lib/html-entities";

export async function getStaticPaths() {
  const docs = await getCollection("exam-prep", (e) => e.data.in_scope);
  return docs.map((e) => {
    const slug = e.id.split("/").pop()!;
    return { params: { subject: e.data.subject, doc: slug } };
  });
}

const subjectSlug = Astro.params.subject!;
const docSlug = Astro.params.doc!;
const doc = await getEntry("exam-prep", `${subjectSlug}/${docSlug}`);
if (!doc) throw new Error(`exam-prep doc ${subjectSlug}/${docSlug} not found`);

const links = await buildLinkMap(subjectSlug);
const html = await renderMarkdownString(stripVaultLeadIn(doc.body ?? "", doc.data.title), subjectSlug, links);

const allDocs = (await getCollection("exam-prep", (e) => e.data.subject === subjectSlug && e.data.in_scope))
  .map((e) => ({ slug: e.id.split("/").pop()!, title: e.data.title, order: e.data.order }));

// Keep the inner HTML so KaTeX in headings renders as real math in the TOC.
const sectionRe = /<(h2|h3)[^>]*id="([^"]+)"[^>]*>(.*?)<\/\1>/g;
const sections: { id: string; text: string; html: string; level: number }[] = [];
let m: RegExpExecArray | null;
while ((m = sectionRe.exec(html)) !== null) {
  sections.push({ id: m[2], text: decodeHtmlEntities(m[3].replace(/<[^>]+>/g, "")).trim(), html: m[3].replace(/<\/?a\b[^>]*>/g, ""), level: m[1] === "h2" ? 2 : 3 });
}

const eyebrow = [doc.data.course, doc.data.instructor].filter(Boolean).join(" · ");
const subject = (await getCollection("subjects", (s) => s.data.slug === subjectSlug))[0];
const termTitles = (await loadCourseContent()).get(subjectSlug)?.termTitles ?? new Map<string, string>();
const concepts = conceptLinks([...vaultKeyConcepts(doc.body ?? ""), ...doc.data.tags], subjectSlug, links, termTitles);
const docHref = (slug: string) => `/subjects/${subjectSlug}/exam-prep/${slug}`;
const { previous, next } = neighbours(sortExamPrep(allDocs), docSlug);
---
<Layout title={`${doc.data.title} · ${subject.data.title}`} subject={subjectSlug} active="exam-prep" hasSidebar>
  <div id="content-grid" class="content-grid">
    <ExamPrepSidebar subject={subjectSlug} docs={allDocs} currentSlug={docSlug} currentSections={sections} />
    <article class="paper-body">
      <PageHead eyebrow={eyebrow} title={doc.data.title} concepts={concepts}>
        {doc.data.description && <p class="page-head-note">{doc.data.description}</p>}
      </PageHead>
      {doc.data.pdf ? (
        <div class="mt-6">
          <a href={doc.data.pdf} target="_blank" rel="noopener" class="pdf-open">
            Open in new tab / download
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
          <div class="pdf-frame mt-4">
            <iframe src={doc.data.pdf} title={doc.data.title} loading="lazy"></iframe>
          </div>
        </div>
      ) : (
        <>
          {doc.data.source_doc?.startsWith("/") && doc.data.source_doc.endsWith(".pdf") && (
            <div class="mt-6">
              <a href={doc.data.source_doc} download class="pdf-open">
                Download the original PDF
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
              </a>
            </div>
          )}
          <div class="mt-8 paper-prose prose-card" set:html={html} />
        </>
      )}
      <PageFoot
        previous={previous && { title: previous.title, href: docHref(previous.slug) }}
        next={next && { title: next.title, href: docHref(next.slug) }}
      />
    </article>
  </div>
  <Mermaid />
  <GraphMounter />
  <HoverPreview subject={subjectSlug} />
</Layout>

<style>
  .pdf-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .pdf-open svg { width: 15px; height: 15px; }
  .pdf-open:hover { color: var(--color-accent-ink); }
  .pdf-frame {
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    background: var(--color-card);
  }
  .pdf-frame iframe {
    display: block;
    width: 100%;
    height: min(85vh, 1100px);
    border: 0;
  }
</style>
