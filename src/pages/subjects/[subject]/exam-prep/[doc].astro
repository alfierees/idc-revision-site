---
import Layout from "../../../../components/Layout.astro";
import HoverPreview from "../../../../components/HoverPreview.astro";
import ExamPrepSidebar from "../../../../components/ExamPrepSidebar.astro";
import GraphMounter from "../../../../components/GraphMounter.astro";
import Mermaid from "../../../../components/Mermaid.astro";
import { getCollection, getEntry } from "astro:content";
import { stripNoteMeta } from "../../../../lib/strip-note-meta";
import { renderMarkdownString } from "../../../../lib/render-markdown-string";
import { buildLinkMap, linkHref, resolveLink } from "../../../../lib/known-links";
import { decodeHtmlEntities } from "../../../../lib/html-entities";
import OpenAnswer from "../../../../components/OpenAnswer";
import McQuestion from "../../../../components/McQuestion";
import ExamScorebar from "../../../../components/ExamScorebar";
import "../../../../styles/mcq.css";
import { detectPaperMcqs } from "../../../../lib/paper-mcq";

export async function getStaticPaths() {
  const docs = await getCollection("exam-prep", (e) => e.data.in_scope);
  return docs.map((e) => {
    const slug = e.id.split("/").pop()!;
    return { params: { subject: e.data.subject, doc: slug } };
  });
}

const subjectSlug = Astro.params.subject!;
const docSlug = Astro.params.doc!;
const doc = await getEntry("exam-prep", `${subjectSlug}/${docSlug}`);
if (!doc) throw new Error(`exam-prep doc ${subjectSlug}/${docSlug} not found`);

const links = await buildLinkMap(subjectSlug);
const html = await renderMarkdownString(stripNoteMeta(doc.body ?? ""), subjectSlug, links);

// Optional self-test questions (frontmatter `questions`), rendered as cards.
const questions = doc.data.questions ?? [];
const autoMcqs = detectPaperMcqs(
  `exam-prep-${docSlug}`,
  questions.filter((q) => !q.options?.length).map((q) => ({ id: q.id, prompt: q.text, answer: q.solution })),
  doc.body ?? "",
);
const renderOpts = (opts: { label: string; text: string; correct: boolean; why: string }[]) =>
  Promise.all(opts.map(async (o) => ({
    label: o.label,
    correct: o.correct,
    html: await renderMarkdownString(o.text, subjectSlug, links),
    whyHtml: o.why ? await renderMarkdownString(o.why, subjectSlug, links) : "",
  })));
const renderedQs = await Promise.all(questions.map(async (q) => {
  const auto = q.options?.length ? null : autoMcqs.get(q.id) ?? null;
  const options = q.options?.length ? await renderOpts(q.options) : auto ? await renderOpts(auto.options) : null;
  return {
    id: q.id,
    title: q.title,
    questionHtml: await renderMarkdownString(auto ? auto.stem : q.text, subjectSlug, links),
    solutionHtml: await renderMarkdownString(auto ? auto.working : q.solution, subjectSlug, links),
    options,
    hasSolution: q.solution.trim().length > 0 || Boolean(options),
  };
}));
const quizRef = `exam-prep-${docSlug}`;

const allDocs = (await getCollection("exam-prep", (e) => e.data.subject === subjectSlug && e.data.in_scope))
  .map((e) => ({ slug: e.id.split("/").pop()!, title: e.data.title, order: e.data.order }));

// Keep the inner HTML so KaTeX in headings renders as real math in the TOC.
const sectionRe = /<(h2|h3)[^>]*id="([^"]+)"[^>]*>(.*?)<\/\1>/g;
const sections: { id: string; text: string; html: string; level: number }[] = [];
let m: RegExpExecArray | null;
while ((m = sectionRe.exec(html)) !== null) {
  sections.push({ id: m[2], text: decodeHtmlEntities(m[3].replace(/<[^>]+>/g, "")).trim(), html: m[3].replace(/<\/?a\b[^>]*>/g, ""), level: m[1] === "h2" ? 2 : 3 });
}

const meta = [doc.data.course, doc.data.instructor].filter(Boolean);
const subject = (await getCollection("subjects", (s) => s.data.slug === subjectSlug))[0];
---
<Layout title={`${doc.data.title} · ${subject.data.title}`} subject={subjectSlug} active="exam-prep" hasSidebar>
  <div id="content-grid" class="content-grid">
    <ExamPrepSidebar subject={subjectSlug} docs={allDocs} currentSlug={docSlug} currentSections={sections} />
    <article class="paper-body">
      {meta.length > 0 && (
        <p class="doc-meta">{meta.join(" · ")}</p>
      )}
      <h1 class="doc-title">{doc.data.title}</h1>
      {doc.data.description && (
        <p class="mt-2 font-ui text-sm text-ink-muted italic">{doc.data.description}</p>
      )}
      {doc.data.pdf ? (
        <div class="mt-6">
          <a href={doc.data.pdf} target="_blank" rel="noopener" class="pdf-open">
            Open in new tab / download
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
          <div class="pdf-frame mt-4">
            <iframe src={doc.data.pdf} title={doc.data.title} loading="lazy"></iframe>
          </div>
        </div>
      ) : (
        <>
          {doc.data.source_doc?.startsWith("/") && doc.data.source_doc.endsWith(".pdf") && (
            <div class="mt-6">
              <a href={doc.data.source_doc} download class="pdf-open">
                Download the original PDF
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
              </a>
            </div>
          )}
          {html.trim() && <div class="mt-8 paper-prose prose-card" set:html={html} />}
          {renderedQs.length > 0 && (
            <ol class="mt-8 space-y-6 list-none p-0">
              {renderedQs.map((q, i) => (
                <li id={`q-${q.id}`} class="qcard rounded-card bg-card p-7 shadow-soft">
                  <span class="qid"><span class="qnum">{q.title ?? `Q${i + 1}`}</span></span>
                  <div class="mt-3 text-base text-ink question-body prose-card" set:html={q.questionHtml} />
                  {q.options ? (
                    <McQuestion client:load subject={subjectSlug} kind="exam-prep" refSlug={quizRef} questionId={q.id} options={q.options} workingHtml={q.solutionHtml} />
                  ) : q.hasSolution && (
                    <OpenAnswer client:load subject={subjectSlug} kind="exam-prep" refSlug={quizRef} questionId={q.id} solutionHtml={q.solutionHtml} />
                  )}
                </li>
              ))}
            </ol>
          )}
        </>
      )}
    </article>
  </div>
  {renderedQs.some((q) => q.hasSolution) && (
    <ExamScorebar client:load subject={subjectSlug} kind="exam-prep" refSlug={quizRef} questionIds={renderedQs.filter((q) => q.hasSolution).map((q) => q.id)} />
  )}
  <Mermaid />
  <GraphMounter />
  <HoverPreview subject={subjectSlug} />
</Layout>

<style>
  .pdf-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .pdf-open svg { width: 15px; height: 15px; }
  .pdf-open:hover { color: var(--color-accent-ink); }
  .pdf-frame {
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    background: var(--color-card);
  }
  .pdf-frame iframe {
    display: block;
    width: 100%;
    height: min(85vh, 1100px);
    border: 0;
  }
</style>
