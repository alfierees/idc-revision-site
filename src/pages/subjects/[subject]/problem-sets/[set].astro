---
import Layout from "../../../../components/Layout.astro";
import HoverPreview from "../../../../components/HoverPreview.astro";
import OpenAnswer from "../../../../components/OpenAnswer";
import ExamScorebar from "../../../../components/ExamScorebar";
import GraphMounter from "../../../../components/GraphMounter.astro";
import Mermaid from "../../../../components/Mermaid.astro";
import QuestionSidebar from "../../../../components/QuestionSidebar.astro";
import PageHead from "../../../../components/PageHead.astro";
import PageFoot from "../../../../components/PageFoot.astro";
import { getCollection, getEntry } from "astro:content";
import { entrySlug } from "../../../../lib/entry-slug";
import { renderMarkdownString } from "../../../../lib/render-markdown-string";
import { buildLinkMap, linkHref, resolveLink } from "../../../../lib/known-links";
import { conceptLinks } from "../../../../lib/concepts";
import { loadCourseContent } from "../../../../lib/course-content";
import { neighbours, sortProblemSets } from "../../../../lib/reading-order";

export async function getStaticPaths() {
  const sets = await getCollection("problem-sets");
  return sets.map((p) => {
    const slug = entrySlug(p.id);
    return { params: { subject: p.data.subject, set: slug } };
  });
}

const subjectSlug = Astro.params.subject!;
const setSlug = Astro.params.set!;
const set = await getEntry("problem-sets", `${subjectSlug}/${setSlug}`);
if (!set) throw new Error(`problem set ${subjectSlug}/${setSlug} not found`);

const links = await buildLinkMap(subjectSlug);

const rendered = await Promise.all(set.data.questions.map(async (q) => ({
  id: q.id,
  questionHtml: await renderMarkdownString(q.text, subjectSlug, links),
  solutionHtml: await renderMarkdownString(q.solution, subjectSlug, links),
  hasSolution: q.solution.trim().length > 0,
})));

const bodyHtml = set.body?.trim()
  ? await renderMarkdownString(set.body, subjectSlug, links)
  : null;

const subject = (await getCollection("subjects", (s) => s.data.slug === subjectSlug))[0];

// --- Toolkit panel computation ---

// Aggregate all related_terms across questions, deduplicate.
const allRelatedTerms = [...new Set(
  set.data.questions.flatMap((q) => q.related_terms)
)];

// Partition into terms and recipes by resolving each slug.
const termTitles = (await loadCourseContent()).get(subjectSlug)?.termTitles ?? new Map<string, string>();
const toolkitTerms: { slug: string; href: string; label: string }[] = [];
const toolkitRecipes: { slug: string; href: string; label: string }[] = [];

for (const raw of allRelatedTerms) {
  const target = resolveLink(links, raw);
  if (!target) continue;
  const entry = { slug: target.slug, href: linkHref(subjectSlug, target), label: raw };
  if (target.kind === "term") toolkitTerms.push({ ...entry, label: termTitles.get(target.slug) ?? raw });
  else if (target.kind === "recipe") toolkitRecipes.push(entry);
}

// Deduplicate by canonical slug (in case two raw aliases resolve to same target).
function dedupBySlug<T extends { slug: string }>(arr: T[]): T[] {
  const seen = new Set<string>();
  return arr.filter((x) => {
    if (seen.has(x.slug)) return false;
    seen.add(x.slug);
    return true;
  });
}
const uniqueToolkitTerms = dedupBySlug(toolkitTerms);
const uniqueToolkitRecipes = dedupBySlug(toolkitRecipes);

// Lectures group: from top-of-page tags + hrefs in rendered HTML.
const allHtml = rendered.map((r) => r.questionHtml + r.solutionHtml).join("") + (bodyHtml ?? "");
const lectureHrefRe = /href="\/subjects\/[^/]+\/lectures\/([^"]+)"/g;
const lectureSlugSet = new Set<string>();

// From top-of-page tags that resolve to lectures.
for (const tag of set.data.tags) {
  const target = resolveLink(links, tag);
  if (target?.kind === "lecture") lectureSlugSet.add(target.slug);
}

// From rendered HTML hrefs.
let lm: RegExpExecArray | null;
while ((lm = lectureHrefRe.exec(allHtml)) !== null) {
  lectureSlugSet.add(lm[1]);
}

// Fetch lecture titles.
const allLectureEntries = await getCollection("lectures", (l) => l.data.subject === subjectSlug);
const lectureBySlug = new Map(
  allLectureEntries.map((l) => [l.id.split("/").pop()!, l.data.title])
);

// All sibling problem sets for the subject — feeds the sidebar's cross-PS nav.
const siblingProblemSets = (await getCollection("problem-sets", (p) => p.data.subject === subjectSlug))
  .map((p) => ({ slug: p.id.split("/").pop()!, title: p.data.title }));

const toolkitLectures = [...lectureSlugSet]
  .filter((slug) => lectureBySlug.has(slug))
  .map((slug) => ({
    slug,
    href: `/subjects/${subjectSlug}/lectures/${slug}`,
    label: lectureBySlug.get(slug)!,
  }));

const hasToolkit =
  uniqueToolkitTerms.length > 0 ||
  uniqueToolkitRecipes.length > 0 ||
  toolkitLectures.length > 0;

const concepts = conceptLinks([...allRelatedTerms, ...set.data.tags], subjectSlug, links, termTitles);
const sourceHref = /^(https?:\/\/|\/)/.test(set.data.source_doc ?? "") ? set.data.source_doc : undefined;
const setHref = (slug: string) => `/subjects/${subjectSlug}/problem-sets/${slug}`;
const { previous, next } = neighbours(sortProblemSets(siblingProblemSets), setSlug);
---
<Layout title={`${set.data.title} · ${subject.data.title}`} subject={subjectSlug} active="problem-sets" hasSidebar continueTitle={set.data.title}>
  <div id="content-grid" class="content-grid wide-toc">
    <QuestionSidebar
      subject={subjectSlug}
      problemSets={siblingProblemSets}
      currentSlug={setSlug}
      currentQuestions={rendered}
    />

    <div class="min-w-0">
      <PageHead title={set.data.title} concepts={concepts}>
        {(sourceHref || set.data.official_solution) && (
          <Fragment slot="actions">
            {sourceHref && <a href={sourceHref} class="page-head-link">Original PDF ↗</a>}
            {set.data.official_solution && (
              <a href={set.data.official_solution} download class="official-dl font-ui text-xs uppercase tracking-[0.15em]" title={set.data.official_solution_note}>
                Official solution ↓
              </a>
            )}
          </Fragment>
        )}
        {set.data.official_solution_note && <p class="page-head-note">{set.data.official_solution_note}</p>}
      </PageHead>

      <ol class="mt-8 space-y-6 list-none p-0">
        {rendered.map((q) => (
          <li id={q.id} class="qcard rounded-card bg-card p-7 shadow-soft">
            <div class="flex items-start justify-between gap-4">
              <span class="qid"><span class="qnum">{q.id}</span></span>
            </div>
            <div class="mt-3 text-base text-ink question-body prose-card" set:html={q.questionHtml} />
            {q.hasSolution && (
              <OpenAnswer
                client:load
                subject={subjectSlug}
                kind="problem-set"
                refSlug={setSlug}
                questionId={q.id}
                solutionHtml={q.solutionHtml}
              />
            )}
          </li>
        ))}
      </ol>

      {bodyHtml && (
        <section class="mt-8 rounded-card bg-card p-7 shadow-soft question-body prose-card" set:html={bodyHtml} />
      )}

      {hasToolkit && (
        <section class="toolkit-foot" aria-label="Toolkit for this set">
          <p class="font-ui text-xs uppercase tracking-[0.15em] text-ink-muted mb-3">Toolkit</p>
          <div class="flex flex-col gap-3">
            {uniqueToolkitTerms.length > 0 && (
              <div>
                <span class="font-ui text-xs uppercase tracking-[0.15em] text-ink-muted mr-2">Terms</span>
                <div class="mt-2 flex flex-wrap gap-2">
                  {uniqueToolkitTerms.map((t) => (
                    <a href={t.href} class="tag tag-link">{t.label}</a>
                  ))}
                </div>
              </div>
            )}
            {uniqueToolkitRecipes.length > 0 && (
              <div>
                <span class="font-ui text-xs uppercase tracking-[0.15em] text-ink-muted mr-2">Recipes</span>
                <div class="mt-2 flex flex-wrap gap-2">
                  {uniqueToolkitRecipes.map((r) => (
                    <a href={r.href} class="tag tag-link">{r.label}</a>
                  ))}
                </div>
              </div>
            )}
            {toolkitLectures.length > 0 && (
              <div>
                <span class="font-ui text-xs uppercase tracking-[0.15em] text-ink-muted mr-2">Lectures</span>
                <div class="mt-2 flex flex-wrap gap-2">
                  {toolkitLectures.map((l) => (
                    <a href={l.href} class="tag tag-link">{l.label}</a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      <PageFoot
        previous={previous && { title: previous.title, href: setHref(previous.slug) }}
        next={next && { title: next.title, href: setHref(next.slug) }}
      />
    </div>
  </div>
  {rendered.some((q) => q.hasSolution) && (
    <ExamScorebar
      client:load
      subject={subjectSlug}
      kind="problem-set"
      refSlug={setSlug}
      questionIds={rendered.filter((q) => q.hasSolution).map((q) => q.id)}
    />
  )}
  <Mermaid />
  <GraphMounter />
  <HoverPreview subject={subjectSlug} />
</Layout>

<style is:global>
  .qcard { scroll-margin-top: calc(var(--toc-top) + 1rem); }
  .qid {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .qid .qnum {
    min-width: 1.7rem;
    height: 1.7rem;
    padding: 0 0.3rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent-ink);
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    letter-spacing: 0;
  }
  /* Lecturer's official solution file — accent-tinted so it reads as the
     authoritative answer key next to the plainer "Original PDF" link. */
  .official-dl {
    color: var(--color-accent);
    font-weight: 700;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .official-dl:hover { background: color-mix(in srgb, var(--color-accent) 18%, transparent); }
</style>
